# Copy to .streamlit/secrets.toml and fill in. Never commit the real file.
# On Streamlit Community Cloud, paste these into the app's Secrets panel instead.

API_KEY = "fw_your_fireworks_key_here"

# During testing, use a serverless model so no deployment is required:
MODEL = "accounts/fireworks/models/llama-v3p1-8b-instruct"

# For the study, use the full model#deployment route for the live on-demand
# deployment. This changes every time a new deployment is brought up.
# MODEL = "accounts/yacchatbot/models/carebot-gemma3-27b-v2#accounts/yacchatbot/deployments/<id>"
