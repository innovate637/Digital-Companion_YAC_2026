+# RAG config (leak-fix + gated retrieval, 2026-07-06).
+# IMPORTANT: RAG_STORE_PATH must point to the REBUILT store (build_rag.py, 2026-07-05:
+# normalized mpnet embeddings + 7 Table-2 docs + 54 labeled YAC passages). The gate
+# threshold below is calibrated for that store; the old UvA_AUG_YAG_chatbot store has
+# unnormalized embeddings and no YAC passages, so the gate math would be wrong there.
+RAG_STORE_PATH = "rag_store"          # adjust to deployment layout
+RAG_GATE_COS = 0.60                   # inject a chunk only if cosine >= this (fires ~20%)
+RAG_FETCH_K = 12                      # candidates considered
+RAG_K = 3                             # max chunks injected
+
 @st.cache_resource
 def load_vectorstore():
     embeddings = HuggingFaceEmbeddings(
-        model_name="sentence-transformers/all-mpnet-base-v2"
+        model_name="sentence-transformers/all-mpnet-base-v2",
+        encode_kwargs={"normalize_embeddings": True},   # must match the store build
     )
 
     return FAISS.load_local(
-        "streamlit/vector_stores/UvA_AUG_YAG_chatbot",
+        RAG_STORE_PATH,
         embeddings,
         allow_dangerous_deserialization=True
     )
 
 vectorstore = load_vectorstore()
 
+
+def gated_retrieve(query: str):
+    """Return up to RAG_K chunks whose cosine similarity clears RAG_GATE_COS.
+
+    With normalized embeddings, FAISS L2 distance relates to cosine as
+    cos = 1 - dist^2 / 2. Returns an empty list when nothing is relevant enough —
+    the caller then sends NO context (plain fine-tuned behavior), per the human-review
+    finding that irrelevant context degrades replies.
+    """
+    hits = vectorstore.similarity_search_with_score(query, k=RAG_FETCH_K)
+    qualifying = [d for d, dist in hits if (1 - dist ** 2 / 2) >= RAG_GATE_COS]
+    return qualifying[:RAG_K]
+
